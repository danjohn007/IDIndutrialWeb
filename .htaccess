Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)servicio= [NC]
  RewriteRule ^$ index.php [L]

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.idindustrial\.com\.mx$ [NC]
  RewriteRule ^ https://idindustrial.com.mx%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_URI} !^/sistema/ [NC]
  RewriteRule ^industriales/cableado-estructurado-queretaro/?$ /sistema/industriales/cableado-estructurado-queretaro/ [L,R=301]
  RewriteCond %{REQUEST_URI} !^/sistema/ [NC]
  RewriteRule ^instalacion-aire-acondicionado-industrial-queretaro/?$ /sistema/instalacion-aire-acondicionado-industrial-queretaro/ [L,R=301]
  RewriteCond %{REQUEST_URI} !^/sistema/ [NC]
  RewriteRule ^control-de-acceso-de-personal-queretaro/?$ /sistema/control-de-acceso-de-personal-queretaro/ [L,R=301]
  RewriteCond %{REQUEST_URI} !^/sistema/ [NC]
  RewriteRule ^instalacion-camaras-seguridad-industrial-queretaro/?$ /sistema/instalacion-camaras-seguridad-industrial-queretaro/ [L,R=301]
  RewriteCond %{REQUEST_URI} !^/sistema/ [NC]
  RewriteRule ^instalacion-camaras-seguridad-industrial-queretaro\.php$ /sistema/instalacion-camaras-seguridad-industrial-queretaro/ [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
